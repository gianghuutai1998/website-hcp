<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/hcp.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>

@{
    var companyName = Environment.GetEnvironmentVariable("COMPANY_NAME");
    var companyAddress = Environment.GetEnvironmentVariable("COMPANY_ADDRESS");
    var companyPhone = Environment.GetEnvironmentVariable("COMPANY_PHONE");
    var companyEmail = Environment.GetEnvironmentVariable("COMPANY_EMAIL");
}

<body>
    <header>
        <div class="banner" style="background: url('./image/bg2.jpg')">
            <div class="info-group">
                <a href="/">
                    <img class="logo" src="~/image/logo.jpg" asp-append-version="true">
                </a>
                <div>
                    <p class="company-name">@companyName</p>
                    <p class="company-address">@companyAddress</p>
                </div>
            </div>
            <p class="hotline"> Hotline: @companyPhone </p>
        </div>
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container">
                <a class="navbar-brand" href="/">GIỚI THIỆU</a>
                <a class="navbar-brand" href="/">TIN TỨC - THÔNG BÁO</a>
                <a class="navbar-brand" href="/">DỊCH VỤ</a>
                <a class="navbar-brand" href="/">LIÊN HỆ</a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" style="color: #FFFFFF" href="/Post/Create">Đăng bài</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" style="color: #FFFFFF" href="/Account/Logout">Đăng xuất (@User.Identity.Name)</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container" style="flex: 1; margin-top: 180px; margin-bottom: 80px;">
        <main role="main" class="pb-3">
            <div class="container" style="flex: 1; margin-top: 180px; margin-bottom: 80px;">
                @RenderBody()
            </div>
        </main>

    <footer class="footer"
        style=" width: 100%; max-width: 1500px;
            border-top: 1px solid #dee2e6;
            padding: 15px 0;
            background-color: #f8f9fa;
            text-align: center;
            font-size: 14px;
            line-height: 1.6;
            margin-left: -102px;">

        <div class="container">
            <strong>CỔNG THÔNG TIN ĐIỆN TỬ</strong><br>
            <strong>@companyName</strong><br>
            Địa chỉ: @companyAddress<br>
            Liên hệ: Hotline <strong>@companyPhone</strong> – Điện thoại <strong>@companyPhone</strong><br>
            Email: <a href="mailto:info@hcp.com.vn">@companyEmail</a><br>
            © HCP 2025
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>